# 필수: 자체 호스팅 ntfy 서버 주소와 토픽
NTFY_URL=https://ntfy.example.com
NTFY_TOPIC=instagram

# ntfy 인증 (둘 중 하나, 필요한 경우만)
NTFY_USER=
NTFY_PASSWORD=

# 필수: 공식 Graph API (Business Discovery). setup_meta_token.py 출력값을 그대로 넣는다.
META_IG_USER_ID=
META_ACCESS_TOKEN=

# 감시할 계정 (쉼표 구분)
IG_USERNAMES=iabstudio,worksout_official

# 매일 확인할 시각과 시간대
RUN_AT=09:00
TIMEZONE=Asia/Seoul
